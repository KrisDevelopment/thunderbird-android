{
  "manifest_version": 2,
  "name": "Thunderbird Android Migration Importer",
  "version": "0.2.0",
  "description": "Imports a Thunderbird for Android migration archive (.tbam) into Thunderbird Desktop.",
  "applications": {
    "gecko": {
      "id": "tb-android-migration-importer@thunderbird.net",
      "strict_min_version": "140.0"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "experiment_apis": {
    "migrationImporter": {
      "schema": "experiments/migrationImporter/schema.json",
      "parent": {
        "scopes": ["addon_parent"],
        "paths": [["migrationImporter"]],
        "script": "experiments/migrationImporter/implementation.js"
      }
    }
  }
}
